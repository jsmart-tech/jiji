# Supabase project credentials (Dashboard → Project Settings → API).
# Leave both empty/unset to run entirely on mock data with no backend required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy: base URL of the old NestJS REST backend (see ../backend). Unused
# once the Supabase vars above are set.
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_APP_NAME=Jiji
